# Secrets — every app keeps its own, none of them are committed
.env
.env.local
.env.*.local

# Dependencies and build output, at any depth in the workspace
node_modules/
.turbo/
dist/
.next/
test-results/
playwright-report/
apps/server/.assistant-e2e-uploads/

# Generated, hash-verified Pyodide runtime (see apps/web/scripts).
apps/web/public/vendor/pyodide/

# Local databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.db.bak*

# Zero-configuration development object storage
.data/

# Editor
.vscode/settings.json
.vscode/tasks.json
.hintrc

# Agent scratch
/.agents
/.playwright-mcp
/.claude

# Local MCP client configuration can contain credentials and machine paths
/.mcp.json
