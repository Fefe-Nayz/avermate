{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avermate.fr/schemas/avermate-node-config-v1.json",
  "title": "Avermate Node configuration",
  "description": "Public, non-secret configuration. Cross-field and host security checks are also enforced by the daemon's Zod schema.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "profile": {
      "type": "string",
      "enum": [
        "dev-zero",
        "node-lite",
        "node-storage",
        "node-creator",
        "node-local-gpu",
        "node-observable",
        "full-self-host"
      ]
    },
    "bind": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      },
      "required": [
        "host",
        "port"
      ],
      "additionalProperties": false
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "storage": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "filesystem",
            "s3"
          ]
        },
        "filesystemRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "s3SecretRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maxObjectBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "quotaBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "driver",
        "maxObjectBytes",
        "quotaBytes"
      ],
      "additionalProperties": false
    },
    "relay": {
      "type": "object",
      "properties": {
        "coreUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/.*"
        },
        "credentialSecretRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "providerSecretRefs": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "enabled",
        "providerSecretRefs"
      ],
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "disabled",
            "opensandbox",
            "microsandbox"
          ]
        }
      },
      "required": [
        "enabled",
        "provider"
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https:\\/\\/.*"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "profile",
    "bind",
    "dataDir",
    "storage",
    "relay",
    "models",
    "sandbox",
    "telemetry"
  ],
  "additionalProperties": false
}
