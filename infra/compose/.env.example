# Generate these locally. Empty/default values deliberately fail the runtime
# preflight; this file contains no usable credential.
BETTER_AUTH_SECRET=
MCP_REQUEST_STATE_SECRET=
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
AVERMATE_PUBLIC_ORIGIN=http://localhost:3000
AVERMATE_API_ORIGIN=http://localhost:5000

# Optional instance-paid provider credentials. Keep every credential bound to
# one exact origin. The legacy generic key is ignored unless its provider is
# explicitly selected.
MISTRAL_API_KEY=
TRANSCRIPTION_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
INFERENCE_PROVIDER=
INFERENCE_API_KEY=

# Roll out the capability registry one processing family at a time. Production
# should first use shadow, review bounded mismatches, then move to registry.
# The master flag moves only families without an explicit override from legacy
# to non-dispatching shadow resolution.
CAPABILITY_REGISTRY_SHADOW=false
CAPABILITY_TTS_EXECUTION=legacy
CAPABILITY_STT_EXECUTION=legacy
CAPABILITY_OCR_EXECUTION=legacy
CAPABILITY_DOCUMENT_EXTRACTION_EXECUTION=legacy
CAPABILITY_RERANK_EXECUTION=legacy
CAPABILITY_EMBEDDING_EXECUTION=legacy
CAPABILITY_LANGUAGE_EXECUTION=legacy
NODE_CAPABILITY_PROTOCOL_V1=false
