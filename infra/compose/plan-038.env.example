# Every image variable is mandatory and must be a reviewed exact tag@sha256.
# No digest is shown here unless it has been verified by the release process.
LITELLM_IMAGE=
LITELLM_POSTGRES_IMAGE=
LOCAL_MODEL_IMAGE=
QDRANT_IMAGE=
TEI_IMAGE=
QWEN3_RERANKER_IMAGE=
OPENCODE_IMAGE=
OPENCODE_DIGEST=
OPENHANDS_IMAGE=
OPENHANDS_DIGEST=
OPENSANDBOX_IMAGE=
MEDIA_WORKER_IMAGE=
MEDIA_WORKER_DIGEST=
OCR_WORKER_IMAGE=
OCR_WORKER_DIGEST=
# This image must already contain the reviewed whisper.cpp binary and pinned
# /models/whisper-large-v3-turbo-q5_0.bin weights.
TRANSCRIPTION_WORKER_IMAGE=
TRANSCRIPTION_WORKER_DIGEST=
LATEX_WORKER_IMAGE=
LATEX_WORKER_DIGEST=
SLIDES_WORKER_IMAGE=
SLIDES_WORKER_DIGEST=
MANIM_WORKER_IMAGE=
MANIM_WORKER_DIGEST=

# Private files are never committed. LiteLLM's env file contains its master
# key/database URL; the Node admin-key file contains the matching scoped key.
LITELLM_ENV_FILE=
LITELLM_DB_ENV_FILE=
LITELLM_ADMIN_KEY_FILE=

# Reviewed model-server directories must be populated by the signed offline
# bundle before Compose starts. Whisper weights are image-owned above, not a
# runtime host mount. Runtime downloads remain disabled everywhere.
LOCAL_MODEL_DIR=
LOCAL_FALLBACK_MODEL_DIR=
TEI_EMBEDDING_MODEL_DIR=
TEI_RERANK_MODEL_DIR=
QWEN3_RERANK_MODEL_DIR=
AVERMATE_NODE_PUBLIC_EMBEDDING_REVISION=
TEI_GTE_RERANK_REVISION=
AVERMATE_NODE_PUBLIC_QWEN3_RERANKER_DIGEST=
AVERMATE_NODE_PUBLIC_MODEL_REVISION=
AVERMATE_NODE_PUBLIC_FALLBACK_MODEL_REVISION=
AVERMATE_NODE_PUBLIC_OCR_MODEL_REVISION=
AVERMATE_NODE_PUBLIC_TRANSCRIPTION_MODEL_REVISION=
AVERMATE_NODE_PUBLIC_SANDBOX_HOST_POLICY_DIGEST=
AVERMATE_NODE_PUBLIC_SANDBOX_EVIDENCE_ENDPOINT=
AVERMATE_NODE_PUBLIC_SANDBOX_RUNTIME_VERSION=
AVERMATE_NODE_PUBLIC_RELEASE_VERSION=
PLAN038_RELEASE_MANIFEST_FILE=
PLAN038_RELEASE_PUBLIC_KEY_FILE=
