{
  "expo": {
    "name": "Avermate",
    "slug": "avermate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avermate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.avermate.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "fr.avermate.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Avermate to choose an image for your profile or feedback.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Avermate to save your year recap image.",
          "savePhotosPermission": "Allow Avermate to save your year recap image.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.fr.avermate.app",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "AvermateSummaryWidget",
              "displayName": "Avermate — Progress",
              "description": "Your private academic progress at a glance.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": false,
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
