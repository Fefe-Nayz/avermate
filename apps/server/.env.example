# Database (libSQL / Turso, or a local file)
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
# Recommended in production; falls back to the domain-separated auth root.
NODE_CREDENTIAL_MASTER_SECRET=
NODE_GRANT_SIGNING_SECRET=
# Production only: the narrowest parent domain shared by web and API hosts.
AUTH_COOKIE_DOMAIN=
# Comma-separated user ids granted the admin role on sign-in
ADMIN_USER_IDS=

# MCP / OAuth 2.1 (defaults MCP_RESOURCE_URL to ${BETTER_AUTH_URL}/mcp)
MCP_RESOURCE_URL=http://localhost:5000/mcp
# Optional separate >=32 character HMAC secret; BETTER_AUTH_SECRET is used otherwise.
MCP_REQUEST_STATE_SECRET=
# Extra comma-separated values for reverse proxies (the public resource host is implicit).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Transitional RFC 7591 endpoint. MCP 2026-07-28 prefers CIMD; keep false normally.
MCP_ENABLE_DCR=false

# Web client
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# Optional managed beta. Operator-paid adapters, beta eligibility enforcement
# and checkout are separate switches. Checkout has no production switch until
# the Phase-D legal/privacy/isolation/restore gates are evidenced.
MANAGED_ACCOUNTING_MODE=shadow
MANAGED_ADAPTERS_ENABLED=false
MANAGED_BETA_ENFORCEMENT_ENABLED=false
MANAGED_REGION=local
MANAGED_TERMS_REVISION=managed-beta/1
MANAGED_PRIVACY_REVISION=managed-privacy/1

# OAuth (each provider is enabled only when both values are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OneDrive Materials connector (can reuse the Microsoft app id/secret).
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/connectors/onedrive/callback
# Public HTTPS URL required only for automatic Graph change notifications.
ONEDRIVE_WEBHOOK_URL=

# Google Drive Materials connector (can reuse the Google OAuth app id/secret).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/connectors/googledrive/callback
# Public HTTPS URL required only for automatic Drive change notifications.
GOOGLE_DRIVE_WEBHOOK_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@avermate.fr

# Uploads. Development defaults to local storage in .data/uploads.
# Production: set STORAGE_DRIVER=s3 and point these values at Garage.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=avermate
S3_PRIVATE_BUCKET=avermate
# Standard deployments use Mistral. The full-self-host Compose profile
# overrides OCR/STT providers to node and does not use either cloud key.
MISTRAL_API_KEY=
OCR_PROVIDER=mistral
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=mistral
# Podcast generation reuses MISTRAL_API_KEY or the user's Mistral BYOK key.
TTS_PROVIDER=mistral
TTS_MODEL=voxtral-mini-tts-2603
TTS_VOICE_ID=
# Provider credentials are origin-specific. The legacy INFERENCE_API_KEY is
# ignored unless INFERENCE_PROVIDER names its one exact destination.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
INFERENCE_PROVIDER=
INFERENCE_API_KEY=
# Web ingestion is intentionally static-only. A remote browser cannot enforce
# Avermate's DNS pinning and redirect checks, so no renderer URL is accepted.
OCR_MAX_PAGES_PER_DOCUMENT=300
TECTONIC_BIN=tectonic
# Optional URL/path for a pinned TeX bundle. Empty uses Tectonic's default bundle.
TECTONIC_BUNDLE=
# Optional absolute cache directory. Empty uses Tectonic's persistent OS cache.
TECTONIC_CACHE_DIR=
# Set true only after pre-warming the cache for an air-gapped deployment.
TECTONIC_ONLY_CACHED=false
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
MAGICK_BIN=magick
FFMPEG_BIN=ffmpeg
DISABLE_OCR=false
DISABLE_TRANSCRIPTION=false
DISABLE_TTS=false

# Optional corpus semantic retrieval. Disabled means lexical-only; partially
# configured values never activate a provider. Recommended cloud baseline:
# Gemini Embedding 2 at 768 dimensions + Qdrant. The Gemini key is resolved
# from the owner's BYOK service key and requires an explicit disclosure consent.
CORPUS_EMBEDDING_ENABLED=false
CORPUS_EMBEDDING_PROVIDER=gemini
CORPUS_EMBEDDING_PLACEMENT=hosted-core
CORPUS_EMBEDDING_BASE_URL=
CORPUS_EMBEDDING_MODEL=
CORPUS_EMBEDDING_DIMENSION=768
CORPUS_EMBEDDING_API_KEY=
CORPUS_EMBEDDING_LOCAL=false
CORPUS_EMBEDDING_NODE_ID=
CORPUS_VECTOR_URL=http://127.0.0.1:6333
CORPUS_VECTOR_API_KEY= # gitleaks:allow -- intentionally empty example
CORPUS_VECTOR_COLLECTION_PREFIX=avermate

# Optional reranking. Core supports owner-BYOK Cohere v4 pro/fast. Paired Node
# supports TEI only for the reviewed GTE text profile, or the dedicated Qwen3
# Transformers worker; Qwen3 is deliberately not presented as a TEI model.
CORPUS_RERANK_ENABLED=false
CORPUS_RERANK_PROVIDER=cohere
CORPUS_RERANK_MODEL=rerank-v4.0-pro
CORPUS_RERANK_PLACEMENT=core
CORPUS_RERANK_BASE_URL=
CORPUS_RERANK_NODE_ID=
CORPUS_RERANK_MODEL_REVISION=
CORPUS_RERANK_IMAGE_DIGEST=
CORPUS_RERANK_TEI_REVISION=
CORPUS_RERANK_RUNTIME_REVISION=

# Local development escape hatches
DISABLE_EMAIL=true
DISABLE_UPLOADS=false
DISABLE_JOBS=false
