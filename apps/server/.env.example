# Database (libSQL / Turso, or a local file)
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
# Production only: the narrowest parent domain shared by web and API hosts.
AUTH_COOKIE_DOMAIN=
# Comma-separated user ids granted the admin role on sign-in
ADMIN_USER_IDS=

# MCP / OAuth 2.1 (defaults MCP_RESOURCE_URL to ${BETTER_AUTH_URL}/mcp)
MCP_RESOURCE_URL=http://localhost:5000/mcp
# Optional separate >=32 character HMAC secret; BETTER_AUTH_SECRET is used otherwise.
MCP_REQUEST_STATE_SECRET=
# Extra comma-separated values for reverse proxies (the public resource host is implicit).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Transitional RFC 7591 endpoint. MCP 2026-07-28 prefers CIMD; keep false normally.
MCP_ENABLE_DCR=false

# Web client
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# OAuth (each provider is enabled only when both values are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@avermate.fr

# Uploads
UPLOADTHING_TOKEN=

# Local development escape hatches
DISABLE_EMAIL=true
DISABLE_UPLOADS=false
