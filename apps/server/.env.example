# Database (libSQL / Turso, or a local file)
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
# Production only: the narrowest parent domain shared by web and API hosts.
AUTH_COOKIE_DOMAIN=
# Comma-separated user ids granted the admin role on sign-in
ADMIN_USER_IDS=

# MCP / OAuth 2.1 (defaults MCP_RESOURCE_URL to ${BETTER_AUTH_URL}/mcp)
MCP_RESOURCE_URL=http://localhost:5000/mcp
# Optional separate >=32 character HMAC secret; BETTER_AUTH_SECRET is used otherwise.
MCP_REQUEST_STATE_SECRET=
# Extra comma-separated values for reverse proxies (the public resource host is implicit).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Transitional RFC 7591 endpoint. MCP 2026-07-28 prefers CIMD; keep false normally.
MCP_ENABLE_DCR=false

# Web client
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# OAuth (each provider is enabled only when both values are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OneDrive Materials connector (can reuse the Microsoft app id/secret).
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/connectors/onedrive/callback
# Public HTTPS URL required only for automatic Graph change notifications.
ONEDRIVE_WEBHOOK_URL=

# Google Drive Materials connector (can reuse the Google OAuth app id/secret).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/connectors/googledrive/callback
# Public HTTPS URL required only for automatic Drive change notifications.
GOOGLE_DRIVE_WEBHOOK_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@avermate.fr

# Uploads. Development defaults to local storage in .data/uploads.
# Production: set STORAGE_DRIVER=s3 and point these values at Garage.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=avermate
S3_PRIVATE_BUCKET=avermate
MISTRAL_API_KEY=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=mistral
# Podcast generation reuses MISTRAL_API_KEY or the user's Mistral BYOK key.
TTS_PROVIDER=mistral
TTS_MODEL=voxtral-mini-tts-2603
TTS_VOICE_ID=
INFERENCE_API_KEY=
# Web ingestion is intentionally static-only. A remote browser cannot enforce
# Avermate's DNS pinning and redirect checks, so no renderer URL is accepted.
OCR_MAX_PAGES_PER_DOCUMENT=300
TECTONIC_BIN=tectonic
# Optional URL/path for a pinned TeX bundle. Empty uses Tectonic's default bundle.
TECTONIC_BUNDLE=
# Optional absolute cache directory. Empty uses Tectonic's persistent OS cache.
TECTONIC_CACHE_DIR=
# Set true only after pre-warming the cache for an air-gapped deployment.
TECTONIC_ONLY_CACHED=false
PDFTOPPM_BIN=pdftoppm
PDFINFO_BIN=pdfinfo
MAGICK_BIN=magick
FFMPEG_BIN=ffmpeg
DISABLE_OCR=false
DISABLE_TRANSCRIPTION=false
DISABLE_TTS=false

# Local development escape hatches
DISABLE_EMAIL=true
DISABLE_UPLOADS=false
DISABLE_JOBS=false
