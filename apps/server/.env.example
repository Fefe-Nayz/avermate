# Database (libSQL / Turso, or a local file)
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
# Production only: the narrowest parent domain shared by web and API hosts.
AUTH_COOKIE_DOMAIN=
# Comma-separated user ids granted the admin role on sign-in
ADMIN_USER_IDS=

# Web client
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# OAuth (each provider is enabled only when both values are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@avermate.fr

# Uploads
UPLOADTHING_TOKEN=

# Feedback relay
DISCORD_WEBHOOK_URL=

# Local development escape hatches
DISABLE_EMAIL=true
DISABLE_FEEDBACK=true
DISABLE_UPLOADS=false
