{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run db:migrate && bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --target=bun --outdir=dist src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test --parallel=1 --timeout=30000",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:local": "bunx turso dev --db-file dev.db",
    "migrate:legacy": "bun scripts/migrate-legacy.ts",
    "admin:set": "bun scripts/set-admin.ts",
    "sandbox:conformance": "bun scripts/sandbox-conformance.ts",
    "sandbox:conformance:mock": "bun scripts/sandbox-conformance.ts --mock",
    "verify:036:evaluation:live": "bun src/search/eval/run-live.ts"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.58",
    "@ai-sdk/openai-compatible": "3.0.35",
