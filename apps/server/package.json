    "@avermate/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@better-auth/core": "1.7.1",
    "@better-auth/expo": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@blockshub/blocksdirecte": "0.0.8-alpha",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "7.0.77",
    "better-auth": "1.7.1",
    "better-upload": "2.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "linkedom": "0.18.13",
