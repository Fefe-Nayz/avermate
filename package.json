{
  "name": "avermate",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:mobile": "turbo -F mobile dev",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "db:seed": "bun run --cwd apps/server scripts/seed-demo.ts",
    "db:migrate-legacy": "bun run --cwd apps/server scripts/migrate-legacy.ts",
    "admin:set": "bun run --cwd apps/server scripts/set-admin.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.8.20"
  },
  "overrides": {
    "@better-fetch/fetch": "1.3.1"
  }
}
