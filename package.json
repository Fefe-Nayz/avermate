    "verify:033:contracts": "bun scripts/verification/plan-033-contracts.ts",
    "verify:033:ingestion": "bun scripts/verification/plan-033-ingestion.ts",
    "verify:033:artifacts": "bun scripts/verification/plan-033-artifacts.ts",
    "verify:033:sandbox:repository": "bun scripts/verification/plan-033-sandbox-repository.ts",
    "verify:033:sandbox:live": "bun scripts/verification/plan-033-sandbox-live.ts",
    "verify:033:sandbox": "bun scripts/verification/plan-033-sandbox.ts",
    "verify:033": "bun scripts/verification/plan-033.ts",
    "verify:034:accounting": "bun scripts/verification/plan-034-accounting.ts",
    "verify:034:storage": "bun scripts/verification/plan-034-storage.ts",
    "verify:034:isolation:shadow": "bun scripts/verification/plan-034-isolation-shadow.ts",
    "verify:034:isolation:live": "bun scripts/verification/plan-034-isolation-live.ts",
    "verify:034:isolation": "bun scripts/verification/plan-034-isolation.ts",
    "verify:034:deletion": "bun scripts/verification/plan-034-deletion.ts",
    "verify:034:restore": "bun scripts/verification/plan-034-restore.ts",
    "verify:034:load": "bun scripts/verification/plan-034-load.ts",
    "verify:034:selfhost-airgap": "bun scripts/verification/plan-034-selfhost-airgap.ts",
    "verify:034:shadow": "bun scripts/verification/plan-034-shadow.ts",
    "verify:034": "bun scripts/verification/plan-034.ts",
