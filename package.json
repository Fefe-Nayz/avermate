{
  "name": "avermate",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "bun run --cwd apps/web format",
