    "release:guard": "bun tools/security/release-guard.ts",
    "verify:025": "bun scripts/verification/plan-025.ts",
    "verify:025:clean-clone": "bun scripts/verification/plan-025.ts --clean-clone",
    "verify:029:citations": "bun scripts/verification/plan-029-citations.ts",
    "verify:032:protocol": "bun scripts/verification/plan-032-protocol.ts",
    "verify:032:storage": "bun scripts/verification/plan-032-storage.ts",
    "verify:032:configurator": "bun scripts/verification/plan-032-configurator.ts",
    "verify:032:selfhost": "bun scripts/verification/plan-032-selfhost.ts",
