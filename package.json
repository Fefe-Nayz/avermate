{
  "name": "avermate",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "bun run --cwd apps/web format",
    "format:check": "bun run --cwd apps/web format:check",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:mobile": "turbo -F mobile dev",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "db:seed": "bun run --cwd apps/server scripts/seed-demo.ts",
    "db:migrate-legacy": "bun run --cwd apps/server scripts/migrate-legacy.ts",
    "admin:set": "bun run --cwd apps/server scripts/set-admin.ts",
    "lint:slop": "bun --bun oxlint",
    "doctor": "react-doctor",
    "doctor:changed": "react-doctor --scope changed"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/expo": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@oxlint/plugins": "^1.79.0",
    "better-auth": "1.7.1",
    "nanostores": "^1.5.2",
    "oxlint": "^1.79.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "react": "19.2.8",
    "react-doctor": "^0.9.12",
    "react-dom": "19.2.8",
    "turbo": "2.10.11"
  },
  "overrides": {
    "@better-fetch/fetch": "1.3.1",
    "expo-constants": "57.0.13"
  },
  "patchedDependencies": {
    "@blockshub/blocksdirecte@0.0.8-alpha": "patches/@blockshub%2Fblocksdirecte@0.0.8-alpha.patch"
  }
}
